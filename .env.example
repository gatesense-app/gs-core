# Claude API
ANTHROPIC_API_KEY=your_key_here
# Optional: override the default model (claude-sonnet-5), e.g. claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: seconds before a Claude call is abandoned. On timeout the pipeline
# falls back to a human rather than guessing (never auto-approves).
LLM_TIMEOUT_SECONDS=45

# TLS verification for Claude calls is ON by default and must stay on in any
# deployed environment. Set to 0 ONLY for local dev behind a corporate proxy
# that re-signs TLS with an internal CA. Better: leave it on and point at the
# corporate CA bundle instead -> SSL_CERT_FILE=/path/to/corporate-ca.pem
# ANTHROPIC_SSL_VERIFY=0

# Postgres. With docker-compose the DB host is 'db'; running the app/migrations
# directly on your host, use localhost:55432 (compose publishes the container
# there to avoid colliding with a local Postgres on 5432). RLS multi-tenancy
# requires Postgres (no SQLite).
DATABASE_URL=postgresql://gatesense:gatesense@localhost:55432/gatesense
