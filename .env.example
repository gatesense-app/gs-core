# Claude API
ANTHROPIC_API_KEY=your_key_here
# Optional: override the default model (claude-sonnet-5), e.g. claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres. With docker-compose the DB host is 'db'; running the app directly on
# your host, use 'localhost'. RLS multi-tenancy requires Postgres (no SQLite).
DATABASE_URL=postgresql://gatesense:gatesense@localhost:5432/gatesense
